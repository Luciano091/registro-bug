# O painel local somente escuta neste computador.
HOST=127.0.0.1
PORT=3210

# Chrome já instalado no computador da BisBurger.
CHROME_PATH=/usr/bin/google-chrome
CHROME_HEADLESS=true
CHROME_NO_SANDBOX=false

BUSINESS_NAME=BisBurger
MENU_URL=https://bisburger.ritmesa.com.br/cardapio
BUSINESS_ADDRESS=Cajueiro-AL
BUSINESS_HOURS=Todos os dias, das 13h às 00h
PAYMENT_METHODS=PIX, dinheiro e cartão
DELIVERY_INFO=Entrega grátis em Cajueiro-AL

# Ponte segura com a caixa de entrada do painel Ritmesa.
BACKEND_URL=https://registro-bug.onrender.com
ESTABLISHMENT_SLUG=bisburger
WHATSAPP_GATEWAY_TOKEN=gere-um-segredo-longo-e-aleatorio

# Quando alguém pedir atendimento humano, o robô fica em silêncio por este período.
HANDOFF_MINUTES=120

# Pequeno atraso para juntar mensagens consecutivas e responder de forma natural.
REPLY_DELAY_MIN_MS=1200
REPLY_DELAY_MAX_MS=2600
